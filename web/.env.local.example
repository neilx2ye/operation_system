# 复制为 .env.local 并填写。云途三项任一缺失 => 演示模式(不调用真实接口)

# ---- 数据存储 ----
# postgres(默认，业务数据落在数据库) | file(旧文件实现，回滚用) | memory(进程内存，测试用)
OPS_STORAGE=postgres
# PostgreSQL 连接串。留空时回退到标准 PG* 环境变量（PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE）
DATABASE_URL=postgres://ops:your-password@127.0.0.1:5432/ops

YUNTU_BASE_URL=            # 云途业务员/官方文档提供的 API 域名
YUNTU_CUSTOMER_CODE=       # 客户编号
YUNTU_API_SECRET=          # ApiSecret
YUNTU_CHANNEL_CODE=        # 渠道服务代码(ShippingMethodCode)
YUNTU_DEFAULT_UNIT_WEIGHT_KG=0.3

SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=       # 自定义 App 的 Admin API token
SHOPIFY_API_VERSION=2025-07
